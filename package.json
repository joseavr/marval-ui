{
  "name": "marval-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Marval UI component library monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:v1": "turbo run --filter=v1 dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky",
    "cm": "cz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/cli": "2.27.12",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "inquirer": "^9.3.8",
    "lint-staged": "15.2.10",
    "turbo": "2.8.2",
    "typescript": "5.6.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  }
}
